{
  "name": "carcara-lncc-client",
  "version": "2.1.0",
  "description": "Cliente API e Chat para Carcara LNCC - OpenRouter Wrapper",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/presentation/server.ts --format esm --target node18 --out-dir dist --clean",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist .carcara test-results",
    "chat": "tsx src/chat-cli.ts",
    "clean:logs": "rm -rf .carcara/*.log",
    "setup": "npm install && npx playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pino": "^9.0.0",
    "playwright": "^1.47.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "@types/ws": "^8.5.10"
  },
  "keywords": [
    "lncc",
    "carcara",
    "sinapad",
    "openrouter",
    "llama",
    "playwright",
    "typescript",
    "chatbot",
    "ai",
    "mcp",
    "santos-dumont",
    "hpc",
    "api-wrapper"
  ],
  "author": "Peter Zeidler",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}